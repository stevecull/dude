# Explorium API key (the API behind Vibe Prospecting), used by fetch_vibe_leads.py
EXPLORIUM_API_KEY=your-explorium-api-key

# Manual mode only: a Vibe Prospecting CSV export URL or local file path.
# Not used by run_daily.sh (it calls fetch_vibe_leads.py instead), only if
# you run connector.py by hand against a manual export.
VIBE_EXPORT_SOURCE=https://example.com/vibe-export.csv

# Column used to detect rows already synced (dedupe key)
VIBE_KEY_COLUMN=prospect_id

# Target Google Sheet
GOOGLE_SHEET_ID=18oxQ5-8pJM5pMPd1u8VDMoAIwJWumGEg-Xa_jYyvAH4
GOOGLE_SHEET_TAB=Vibe Prospects

# Optional: path to a service-account JSON key with access to the sheet above.
# Leave unset to use gcloud Application Default Credentials instead (run
# `gcloud auth application-default login` first, and make sure your Google
# account already has edit access to the sheet).
GOOGLE_APPLICATION_CREDENTIALS=
