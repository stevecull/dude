# Vibe Prospecting CSV export (URL from the `export-to-csv` tool, or a local file path)
VIBE_EXPORT_SOURCE=https://example.com/vibe-export.csv

# Column in the export used to detect rows already synced (dedupe key)
VIBE_KEY_COLUMN=prospect_id

# Target Google Sheet
GOOGLE_SHEET_ID=your-google-spreadsheet-id
GOOGLE_SHEET_TAB=Vibe Prospects

# Path to the Google service-account JSON key with access to the sheet above
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
